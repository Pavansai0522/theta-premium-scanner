# Copy to .env (git-ignored) and export before running:  set -a; source .env; set +a
ALPACA_API_KEY=your-paper-key-id
ALPACA_API_SECRET=your-paper-secret
# "indicative" is the free options feed; use "opra" if your account has the OPRA subscription
ALPACA_OPTIONS_FEED=indicative
# "iex" is free; "sip" requires a subscription
ALPACA_STOCK_FEED=iex
